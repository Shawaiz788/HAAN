# -----------------------------------------------------------------------------
# KaamKarwao - Environment Variables Configuration Template
# Copy this file to '.env' or '.env.local' and populate with your environment values.
# DO NOT commit real secrets or production credentials to source control.
# -----------------------------------------------------------------------------

# Backend REST API & WebSocket Host Base URL (Required)
# Used across API services, fetch client, and WebSocket connections.
# Example (Local): http://192.168.1.100:8000/
# Example (Prod):  https://api.kaamkarwao.com/
EXPO_PUBLIC_API_URL=https://your-api-domain.com/

# Agora RTC Voice Calling Credentials (Required for In-App Voice Calling)
# Obtain your App ID & Primary Certificate from the Agora Console: https://console.agora.io/
EXPO_PUBLIC_AGORA_APP_ID=YOUR_AGORA_APP_ID_HERE
EXPO_PUBLIC_AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE_HERE
