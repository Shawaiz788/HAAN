# -----------------------------------------------------------------------------
# KaamKarwao - Environment Variables Template
# Copy this file to .env and fill in your environment-specific values.
# DO NOT commit real secrets or production credentials to source control.
# -----------------------------------------------------------------------------

# Backend REST & WebSocket API Base URL (Required)
# Example: https://api.kaamkarwao.com/ or http://192.168.1.100:8000/
EXPO_PUBLIC_API_URL=https://your-api-domain.com/

# Agora RTC App ID for Native VoIP Audio Calling (Required for in-app voice calls)
# Obtain from Agora Console: https://console.agora.io/
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# Google Maps SDK API Key (Optional)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
